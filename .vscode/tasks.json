{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "UV: Run Lock",
      "type": "shell",
      "command": ["uv lock"],
      "problemMatcher": []
    },
    {
      "label": "UV: Run Upgrade",
      "type": "shell",
      "command": ["uv sync --upgrade"],
      "problemMatcher": []
    },
    {
      "label": "PYPI: Run Deploy",
      "type": "shell",
      "command": ["uv build --wheel;", "uv publish"],
      "problemMatcher": []
    },
    {
      "label": "Ruff: Run Check",
      "type": "shell",
      "command": [
        "uv run ruff check --fix --show-fixes --config pyproject.toml"
      ],
      "problemMatcher": []
    },
    {
      "label": "Pyrefly: Run Type Checker",
      "type": "shell",
      "command": ["uv run pyrefly check ."],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Install",
      "type": "shell",
      "command": ["uv run pre-commit install"],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Autoupdate",
      "type": "shell",
      "command": ["uv run pre-commit autoupdate"],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Run Check",
      "type": "shell",
      "command": [
        "uv run pre-commit run --show-diff-on-failure --color=always --all-files"
      ],
      "problemMatcher": []
    },
    {
      "label": "Pre-Commit: Fix conflict with auto-fixes",
      "type": "shell",
      "command": ["git add ."],
      "problemMatcher": []
    },
    {
      "label": "UnitTest: Run Tests",
      "type": "shell",
      "command": [
        "uv run python pyhelpers/remove_pycache.py;",
        "uv run python -m unittest tests/test_translator.py;",
        "uv run python -m unittest tests/test_config.py;",
        "uv run python -m unittest tests/test_utils.py;",
        "uv run python -m unittest tests/test_unit.py;",
        "uv run python -m unittest discover -s tests/fields;",
        "uv run python -m unittest tests/test_meta.py;",
        "uv run python -m unittest tests/test_model.py;",
        "uv run python -m unittest tests/test_extra.py;",
        "uv run python -m unittest tests/test_json.py;",
        "uv run python -m unittest tests/test_mongo.py;",
        "uv run python -m unittest tests/test_migration.py;",
        "uv run python -m unittest tests/paladins/test_check.py;",
        "uv run python -m unittest tests/paladins/test_save.py;",
        "uv run python -m unittest tests/paladins/test_password.py;",
        "uv run python -m unittest tests/commons/test_utils.py;",
        "uv run python -m unittest tests/commons/test_general.py;",
        "uv run python -m unittest tests/commons/test_indexes.py;",
        "uv run python -m unittest tests/commons/test_many.py;",
        "uv run python -m unittest tests/commons/test_one.py;",
        "uv run python -m unittest tests/commons/test_unit.py;",
        "uv run python -m unittest tests/test_fixtures.py;",
        "uv run python -m unittest tests/final/test_basic_1.py;",
        "uv run python -m unittest tests/final/test_basic_2.py;",
        "uv run python -m unittest tests/final/test_basic_3.py;",
        "uv run python -m unittest tests/final/test_dynamic_choices.py;",
        "uv run python -m unittest tests/final/test_files.py;",
        "uv run python -m unittest tests/final/test_fixtures.py;",
        "uv run python -m unittest tests/final/test_hooks.py;",
        "uv run python -m unittest tests/final/test_indexing.py;",
        "uv run python -m unittest tests/final/test_multi_fixture.py;",
        "uv run python -m unittest tests/final/test_password.py;",
        "uv run python -m unittest tests/final/test_static_choices.py;",
        "uv run python pyhelpers/remove_pycache.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Create New Docs",
      "type": "shell",
      "command": ["uv run mkdocs new ."],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Build",
      "type": "shell",
      "command": ["uv run mkdocs build"],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Serve",
      "type": "shell",
      "command": ["uv run mkdocs serve"],
      "problemMatcher": []
    },
    {
      "label": "MkDocs: Run Deploy 2.0",
      "type": "shell",
      "command": [
        "uv run mike deploy --push --update-aliases 2.0 latest;",
        "uv run mike set-default --push latest"
      ],
      "problemMatcher": []
    },
    {
      "label": "Babel: Run Update Translations",
      "type": "shell",
      "command": [
        "uv run pybabel extract -o config/translations/ramifice.pot src/ramifice;",
        "uv run pybabel update -i config/translations/ramifice.pot -d config/translations/ramifice"
      ],
      "problemMatcher": []
    },
    {
      "label": "Babel: Run Compile Translations",
      "type": "shell",
      "command": ["uv run pybabel compile -d config/translations/ramifice"],
      "problemMatcher": []
    }
  ]
}
